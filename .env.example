# Copy to .env.local for development, or .env.production for Docker deployment.
# Never commit the populated file or put API secrets in NEXT_PUBLIC_ variables.

# Free AI / web search. Keep both provider accounts on their FREE plans.
# https://console.groq.com/keys
# https://app.tavily.com/
ADVISOR_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
TAVILY_API_KEY=

# Production domain (no slash on SITE_DOMAIN; APP_ORIGIN is the full HTTPS origin).
SITE_DOMAIN=www.readytostudy.org
APP_ORIGIN=https://www.readytostudy.org

# Generate two independent values with: openssl rand -hex 32
APP_SECRET=
ADMIN_INVITE_CODE=

# Optional Google Identity Services sign-up/login. Web OAuth client ID only;
# configure your exact HTTPS origins in Google Auth Platform. No client secret needed.
GOOGLE_CLIENT_ID=

# Production persistence. Docker uses /data; for local development leave this blank.
RTS_DATA_DIR=
# Vercel: connect a Neon/PostgreSQL database. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Cloudflare Turnstile -> Managed widget -> add your exact domain.
# These are read at runtime. Only the site key is sent to the browser.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only set when the trusted reverse proxy OVERWRITES this header.
# The included Caddy configuration does this. Never expose the app port publicly.
ADVISOR_TRUSTED_IP_HEADER=

# Optional existing enquiry webhook. Enquiries are also stored for the admin inbox.
CONTACT_WEBHOOK_URL=

# Transactional email. Verify readytostudy.com.au in Resend before activation.
RESEND_API_KEY=
EMAIL_FROM=Ready to Study <info@readytostudy.com.au>
EMAIL_REPLY_TO=contact@readytostudy.com.au
CONTACT_NOTIFICATION_EMAIL=contact@readytostudy.com.au
